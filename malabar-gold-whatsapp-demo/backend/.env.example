# Maya backend configuration (copy to .env). All optional for the demo.

# Port for the mock API server
PORT=8787

# WhatsApp Cloud API webhook verification token (used by GET /webhook/whatsapp)
WHATSAPP_VERIFY_TOKEN=malabar-maya-demo

# --- Production-only (leave blank for the demo) ---
# When set, backend/lib/agent.js can route conversations through Claude tool-calling.
# ANTHROPIC_API_KEY=
# Recommended tiers:  claude-opus-4-8 (complex) | claude-sonnet-4-6 (default) | claude-haiku-4-5 (routing)

# WhatsApp Cloud API credentials (production)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
